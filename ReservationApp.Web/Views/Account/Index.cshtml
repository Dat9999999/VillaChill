@model List<UserVM>

@{
    ViewData["Title"] = "All Users";
    var keyword = Context.Request.Query["search"];
}

<div class="container-fluid px-4 d-flex flex-column min-vh-100">

    <!-- Nội dung chính -->
    <div class="flex-grow-1">

        <!-- Wrapper Flex Column -->
        <div class="d-flex flex-column w-100 gap-3">

            <!-- Search Bar -->
            <form method="get" class="mb-3" style="max-width: 300px;">
                <div class="input-group">
                    <input type="text" name="search" value="@keyword"
                           class="form-control border-start-0" placeholder="Search name or email" />
                    <button class="btn btn-primary" type="submit">
                        <i class="bi bi-search text-muted"></i> Search
                    </button>
                </div>
            </form>

            <!-- User Table -->
            <table class="table table-hover align-middle w-100 mb-0">
                <thead class="table-light">
                    <tr>
                        <th><input type="checkbox" /></th>
                        <th>User name</th>
                        <th>Access</th>
                        <th>Last active</th>
                        <th>Date added</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td><input type="checkbox" /></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@user.AvatarUrl" class="rounded-circle me-3" width="40" height="40" style="object-fit: cover;" />
                                    <div>
                                        <div class="fw-semibold">@user.Name</div>
                                        <small class="text-muted">@user.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-success me-1">@user.Role</span>
                            </td>
                            <td>
                                @(user.LastLoginTime != null ? user.LastLoginTime.ToString("MMM d, yyyy") : "-")
                            </td>
                            <td>@user.CreatedAt.ToString("MMM d, yyyy")</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown">
                                        ⋮
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-action="Details" asp-route-id="@user.Id">
                                                <i class="bi bi-eye-fill"></i> View
                                            </a>
                                        </li>
                                        @if (user.IsLocked)
                                        {
                                            <li>
                                                <a class="dropdown-item text-success" asp-action="Unlock" asp-route-id="@user.Id">
                                                    <i class="bi bi-unlock-fill"></i> Unlock
                                                </a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <a class="dropdown-item text-danger" asp-action="Lock" asp-route-id="@user.Id">
                                                    <i class="bi bi-lock-fill"></i> Lock
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination stick-bottom -->
    <div class="mt-auto pt-3">
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mb-0">
                <li class="page-item active"><a class="page-link" href="#">1</a></li>
                <li class="page-item"><a class="page-link" href="#">2</a></li>
                <li class="page-item"><a class="page-link" href="#">3</a></li>
            </ul>
        </nav>
    </div>
</div>
