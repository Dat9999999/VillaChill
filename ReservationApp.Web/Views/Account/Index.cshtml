@model UserManagementVM

@{
    ViewData["Title"] = "All Users";
    var keyword = Context.Request.Query["search"];
    var pageSizeDefault = 3;
    int totalPages = (int)Math.Ceiling((double)Model.TotalCount / pageSizeDefault);
}

<div class="container-fluid px-4 d-flex flex-column ">

    <!-- Nội dung chính -->
    <div class="flex-grow-1">

        <!-- Wrapper Flex Column -->
        <div class="d-flex flex-column w-100 gap-3">

            <!-- Search Bar -->
            <form method="get" class="mb-3" style="max-width: 300px;">
                <div class="input-group input-group-sm">
                    <input type="text"
                           name="search"
                           value="@keyword"
                           class="form-control"
                           placeholder="Search by name or email..." />
                    <button class="btn btn-outline-secondary" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>


            <!-- User Table -->
            <table class="table table-hover align-middle w-100 mb-0">
                <thead class="table-light">
                    <tr>
                        <th><input type="checkbox" /></th>
                        <th>User name</th>
                        <th>Access</th>
                        <th>Last active</th>
                        <th>Date added</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td><input type="checkbox" /></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@user.AvatarUrl" class="rounded-circle me-3" width="40" height="40" style="object-fit: cover;" />
                                    <div>
                                        <div class="fw-semibold">@user.Name</div>
                                        <small class="text-muted">@user.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge bg-success me-1">@user.Role</span>
                            </td>
                            <td>
                                @(user.LastLoginTime != null ? user.LastLoginTime.ToString("MMM d, yyyy") : "-")
                            </td>
                            <td>@user.CreatedAt.ToString("MMM d, yyyy")</td>
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-light" type="button" data-bs-toggle="dropdown">
                                        ⋮
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="btn btn-sm btn-light view-user-btn" data-user-id="@user.Id">
                                                <i class="bi bi-eye-fill"></i> View
                                            </a>
                                        </li>
                                        @if (user.Role != SD.Role_Admin)
                                        {
                                            if (user.IsLocked)
                                            {
                                                <li>
                                                    <a class="dropdown-item text-success" asp-action="Unlock" 
                                                       asp-route-userId="@user.Id">
                                                        <i class="bi bi-unlock-fill"></i> Unlock
                                                    </a>
                                                </li>
                                            }
                                            else
                                            {
                                                <li>
                                                    <a class="dropdown-item text-danger" asp-action="Lock" asp-route-userId="@user.Id">
                                                        <i class="bi bi-lock-fill"></i> Lock
                                                    </a>
                                                </li>
                                            }
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination stick-bottom -->
    <div class="mt-auto pt-3">
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mb-0">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item"><a class="page-link @(i == Model.CurrentPage ? "active" : "")"  asp-controller="Account" asp-action="Index" asp-route-search="@keyword"
                                             asp-route-page= "@i" >@i</a></li>
                }
            </ul>
        </nav>
    </div>
</div>
<div class="modal fade" id="userDetailModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">User Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="user-detail-content">
                <div class="text-center text-muted">Loading...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".view-user-btn").forEach(btn => {
                btn.addEventListener("click", function () {
                    const userId = this.getAttribute("data-user-id");
                    const modalBody = document.getElementById("user-detail-content");
                    modalBody.innerHTML = `<div class="text-center text-muted">Loading...</div>`;
                    
                    fetch(`/Account/Profile?userId=${userId}`)
                        .then(res => res.text())
                        .then(html => {
                            modalBody.innerHTML = html;
                            const modal = new bootstrap.Modal(document.getElementById("userDetailModal"));
                            modal.show();
                        })
                        .catch(err => {
                            modalBody.innerHTML = `<div class="text-danger">Failed to load user details.</div>`;
                        });
                });
            });
        });
    </script>
    <script>
    document.querySelector("form").addEventListener("submit", function () {
        const pageInput = document.querySelector("input[name='page']");
        if (pageInput) pageInput.value = 1;
    });
    </script>
}
