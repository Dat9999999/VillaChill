@{
    ViewData["Title"] = "Home Page";
}
@model HomeVM
<div>
    <div id="carouselExampleIndicators" class="carousel slide">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1" aria-label="Slide 2"></button>
            <button type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2" aria-label="Slide 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="~/images/slide2.jpg" class="d-block w-100" alt="...">
            </div>
            <div class="carousel-item">
                <img src="~/images/slide1.jpg" class="d-block w-100" alt="...">
            </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Next</span>
        </button>
    </div>
    <form id="availabilityForm"
          method="post" style="background-color:black">
        <div class="row g-3 align-items-end px-md-5 px-2 pt-4">

            <!-- City -->
            <div class="col-12 col-md-4">
                <label asp-for="City" class="form-label ms-2">Select a province/city:</label>
                <select asp-for="City" id="province" class="form-control border shadow">
                    <option >Loading...</option>
                </select>
            </div>

            <!-- Check In Date -->
            <div class="col-12 col-md-3">
                <label for="CheckInDate" class="form-label"><i class="bi bi-calendar2-date"></i>Check In Date</label>
                <input asp-for="CheckInDate" type="date" class="form-control" />
            </div>

            <!-- Nights -->
            <div class="col-6 col-md-2">
                <label for="Nights" class="form-label"><i class="bi bi-moon"></i>No. of nights</label>
                <select class="form-select" asp-for="Nights">
                    @for (int i = 1; i <= 10; i++)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>

            <!-- Submit Button -->
            <div class="col-6 col-md-3 text-md-start text-end">
                <button type="submit" class="btn btn-success w-100">
                    <i class="bi bi-search"></i> &nbsp;Check Availability
                </button>
            </div>
            <!-- Notice to user -->
            <div id="searchNotice" class="alert alert-info mt-4 mx-md-5 mx-2">
                Please click <strong>"Check Availability"</strong> to find a villa that suits you.
            </div>

        </div>
        <div id="VillasList">
        </div>
    </form>
    
</div>
@section Scripts {
    <script>
        $(document).ready(function() {
            $("form").submit(function(e) {
                e.preventDefault(); // Prevent default form submission
                $(".spinner").show();
                var checkInDate = $("#CheckInDate").val();
                var nights = $(".form-select").val();
                var city = $("#province").val();
        
                $.ajax({
                    url: '/Home/CheckAvailability',
                    type: 'POST',
                    data: {
                        checkInDate: checkInDate,
                        nights: nights,
                        city : city,
                    },
                    success: function(response) {
        
                        $("#VillasList").html(response);
                        $("#searchNotice").fadeOut();
                        reachedEnd = false;
                        isLoading = false;
                        
                        const $container = $('#VillaContainer');
                        if ($container.length > 0) {
                            $container.attr('data-page', 1); // reset page
                        }
                        
                    },
                    error: function(xhr, status, error) {
                        console.error('Error:', error);
                        alert('Failed to check availability. Please try again.');
                    },
                    complete: function() {
                        $( ".spinner" ).hide();
                    }
                });
            });
        });
</script>
    <script>
    let reachedEnd = false;
    let isLoading = false;

    let scrollTimeout = null;

    $(window).on('scroll', function () {
        if (isLoading || reachedEnd ) return;

        const scrollTop = $(window).scrollTop();
        const scrollBottom = scrollTop + $(window).height();
        const docHeight = $(document).height();

        if (scrollBottom + 100 >= docHeight) {
            loadMoreVillas();
        }
    });

    function loadMoreVillas() {
        isLoading = true;
        $('#scrollSpinner').show();
        let city = $("#province").val();
        if (!city || city === "Loading...") return;

        const $container = $('#VillaContainer');
        const currentPage = parseInt($container.attr('data-page')) || 1;
        const nextPage = currentPage + 1;
        const pageSize = 6;
        let nights = $(".form-select").val();
        let checkInDate = $("#CheckInDate").val();

        $.ajax({
            url: `/Home/LoadMoreVillas?page=${nextPage}&pageSize=${pageSize}&city=${city}&checkInDate=${encodeURIComponent(checkInDate)}&nights=${nights}`,
            method: 'GET',
            success: function (html) {
                if ($.trim(html) === "") {
                    reachedEnd = true; // Không còn dữ liệu
                } else {
                    $container.append(html);
                    $container.attr('data-page', nextPage);
                }
            },
            error: function (xhr, status, error) {
                console.error("Lỗi khi tải thêm villa:", error);
            },
            complete: function () {
                isLoading = false;
                $('#scrollSpinner').hide();
            }
        });
    }
</script>
    
}