@model HomeVM
<div id="VillaContainer" class="row px-lg-5 m-lg-4 m-sm-0 px-sm-0" style="--bs-gutter-x:0" data-page="1">
    @if (Model.VillaList != null && Model.VillaList.Any())
    {
        
        @await Html.PartialAsync("_VillaCard", Model.VillaList, new ViewDataDictionary(ViewData)
        {
            { "CheckInDate", Model.CheckInDate },
            { "Nights", Model.Nights }
        })
    }
    else
    {
        <div class="alert alert-warning text-center fw-bold mt-4">
            No villas were found matching your search criteria.
        </div>
    }
</div>
<div class="text-center my-4">
    <div id="scrollSpinner" class="spinner-border text-success" role="status" style="display: none;">
        <span class="visually-hidden">Loading...</span>
    </div>
</div>