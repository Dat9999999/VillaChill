@model UserProfileVM

<div class="d-flex gap-4">
    <img src="@Model.AvatarUrl" class="rounded border" width="120" height="120" style="object-fit: cover;" />
    <div>
        <p><strong>Name:</strong> @Model.Name</p>
        <p><strong>Email:</strong> @Model.Email</p>
        <p><strong>Role:</strong> @Model.Role</p>
        <p><strong>Phone:</strong> @Model.PhoneNumber</p>
        <p><strong>Status:</strong>
            @(Model.IsLocked ?@Html.Raw("<span class='text-danger fw-bold'>Locked</span>" )
                : @Html.Raw("<span class='text-success fw-bold'>Active</span>" ))
    </div>
</div>