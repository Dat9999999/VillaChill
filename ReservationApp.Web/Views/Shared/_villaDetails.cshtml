@model Villa
@using ReservationApp.Views.ViewHelper
<div class="row">
    <div class="col-12 col-md-5">
        <img src="@Model.ImageUrl" style="border-radius:10px;" width="100%" />
    </div>
    <div class="col-12 col-md-7">
        <div class="row p-2">
            <div class="col-12">
                <p class="card-title text-warning" style="font-size:xx-large">@Model.Name</p>
                <p class="card-text" style="font-size:large">
                    @Html.Raw(Model.Description)
                </p>
            </div>
        </div>
        <div class="row col-12">
            <span class="text-end p-0 pt-3 m-0">
                <span class="float-right">Max Occupancy : @Model.Occupancy adults </span><br />
                <span class="float-right pt-1">Villa Size : @Model.Sqft sqft</span><br />
                <span class="float-right pt-1">Address : @Model.Address</span><br />
                <span class="float-right pt-1">City/Province : @Model.City</span><br />
                
                <p class="text-warning font-weight-bold pt-1">
                    <span>
                        @Model.Price.ToString("c") / night
                    </span>
                </p>
            </span>
        </div>
    </div>
    
    <!-- Tab buttons -->
    <div class="btn-group mb-3" role="group">
        <button type="button" class="btn btn-outline-primary active" id="tab-amenities-btn">Amenities</button>
        <button type="button" class="btn btn-outline-primary" id="tab-reviews-btn">Reviews</button>
    </div>

    <!-- Tab content container -->
    <div class="tab-content">
        <div id="tab-amenities" class="row row-cols-1 row-cols-md-2 g-3 mt-2 tab-pane active">
            @foreach (var amenity in Model.Amenities)
            {
                <div class="col">
                    <div class="d-flex align-items-center p-3 rounded-4 shadow-sm amenity-card">
                        <div class="icon-box me-3 d-flex justify-content-center align-items-center">
                            <i class="@ViewFunction.GetAmenityIconClass(amenity.Name) fs-3 text-primary"></i>
                        </div>
                        <div class="text-white fw-medium fs-5">@amenity.Name</div>
                    </div>
                </div>
            }
        </div>




        <!-- Reviews Tab -->
        <div id="tab-reviews" class="tab-pane" style="display:none;">
            <div id="ratings-container-@Model.Id" class="rating-container ratings-box"
                 data-villa-id="@Model.Id" data-loaded="false">
                <div class="rating-header d-flex align-items-center gap-3">
                    <div class="overall-score">
                        <div class="score-number">
                            <i class="bi bi-star-fill"></i>  4/5
                        </div>
                    </div>
                    <div class="rating-info">
                        <h2>Very Good</h2>
                        <div class="review-count">From 1,200 reviews</div>
                    </div>
                </div>
                <div class="ratings-list"></div>
            </div>
        </div>
    </div>
</div>
