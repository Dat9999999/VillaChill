@model IEnumerable<Villa>

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h3 class="text-white py-2">Villas</h3>
            </div>
        </div>
    </div>

    <div class="card-body border py-4">
        <div class="row pb-3">
            <div class="col-6 offset-6 text-end">
                <a asp-controller="Villa" asp-action="Create" class="btn btn-secondary">
                    <i class="bi bi-plus"></i> Create Villa
                </a>
            </div>
        </div>

        <div class="row">
            @foreach (var villa in Model)
            {
                <div class="col-xl-4 col-lg-6 col-md-6 mb-4">
                    <div class="card shadow-sm h-100 border-1">
                        <div class="card-body">
                            <img src="@villa.ImageUrl" class="card-img-top" alt="@villa.Name" style="height: 180px; object-fit: cover;">
                            <h5 class="card-title">@villa.Name</h5>
                            <p class="card-subtitle mb-2 text-muted">@villa.Address, @villa.City</p>

                            <ul class="list-unstyled small">
                                <li><strong>Sqft:</strong> @villa.Sqft</li>
                                <li><strong>Price:</strong> @villa.Price.ToString("N0")</li>
                                <li><strong>Occupancy:</strong> @villa.Occupancy</li>
                                @if (User.IsInRole(SD.Role_Admin))
                                {
                                    <li><strong>Owner email:</strong> @villa.OwnerEmail</li>
                                }
                            </ul>

                            <div class="d-flex justify-content-end">
                                <a asp-controller="Villa" asp-action="Update" asp-route-VillaId="@villa.Id"
                                   class="btn btn-sm btn-warning me-2">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-controller="Villa" asp-action="Delete" asp-route-VillaId="@villa.Id"
                                   class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
