@model IEnumerable<VillaNumber>

<div class="w-100 card border-0 p-4">
    <div class="card-header bg-success bg-gradient ml-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h3 class="text-white py-2">Villa numbers</h3>
            </div>
        </div>
    </div>
    <div class="card-body border py-4">
        <div class="row pb-3">
            <div class="col-6 offset-6 text-end">
                <a asp-controller="VillaNumber" asp-action="Create" class="btn btn-secondary">
                    <i class="bi bi-plus"></i> Create Villa Number
                </a>
            </div>
        </div>

        <div class="row">
            @foreach (var group in Model.GroupBy(v => v.Villa.Name))
            {
                <div class="card mb-4 shadow border border-1">
                    <div class="card-header bg-dark text-white fw-semibold">
                        @group.Key
                    </div>
                    <div class="card-body">
                        @foreach (var room in group)
                        {
                            <div class="room-horizontal d-flex border rounded p-4 mb-4 align-items-center shadow-sm bg-dark text-white">
                                <!-- Hình ảnh đại diện -->
                                <div class="me-4 flex-shrink-0">
                                    <img src="https://via.placeholder.com/200x150.png?text=Room+@room.Villa_Number"
                                         class="rounded border room-image"
                                         alt="Room @room.Villa_Number">
                                </div>

                                <!-- Thông tin phòng -->
                                <div class="flex-grow-1">
                                    <div class="fw-bold fs-4 text-white">Room @room.Villa_Number</div>
                                    @if (!string.IsNullOrEmpty(room.SpecialDetails))
                                    {
                                        <div class="text-light fs-6">@room.SpecialDetails</div>
                                    }
                                    <div class="mt-3">
                                        <span class="badge bg-secondary me-2">Max: 2 Guests</span>
                                        <span class="badge bg-info">Non-smoking</span>
                                    </div>
                                </div>

                                <!-- Nút thao tác -->
                                <div class="text-end ms-4">
                                    <a asp-controller="VillaNumber" asp-action="Update" asp-route-VillaNumber="@room.Villa_Number" class="btn btn-sm btn-warning me-2 fs-5 px-3 py-2">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <a asp-controller="VillaNumber" asp-action="Delete" asp-route-VillaNumber="@room.Villa_Number" class="btn btn-sm btn-danger fs-5 px-3 py-2">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
